# Copy to .env on the Ubuntu server. Never commit the real file.
TOMATO_DOMAIN=tomato.example.com

DB_NAME=tomato_companion
DB_USERNAME=tomato
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

